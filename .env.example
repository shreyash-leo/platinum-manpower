# SMTP details supplied by your email provider.
# These host/port values work for Google Workspace and Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@platinummanpowerservices.com
SMTP_PASS=replace-with-an-app-password

# The sender must normally match the authenticated SMTP account.
SMTP_FROM=contact@platinummanpowerservices.com
ENQUIRY_TO=contact@platinummanpowerservices.com
